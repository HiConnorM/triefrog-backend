{
  "name": "triefrog",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d postgres redis minio && pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "db:generate": "pnpm --filter @triefrog/db generate",
    "db:migrate": "pnpm --filter @triefrog/db migrate:dev",
    "db:migrate:prod": "pnpm --filter @triefrog/db migrate:deploy",
    "db:seed": "pnpm --filter @triefrog/db seed",
    "db:studio": "pnpm --filter @triefrog/db studio",
    "db:reset": "pnpm --filter @triefrog/db migrate:reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "test": "pnpm --parallel --filter './apps/*' test",
    "lint": "pnpm --parallel run lint",
    "format": "prettier --write '**/*.{ts,tsx,js,json,md}'"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
